{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // js/data-products-browser.js is generated from src/ (npm run check:browser guards it);
  // the static HTML pages and archive/ are out of scope.
  "files": { "includes": ["src/**", "tests/**", "scripts/**", "*.json", "!package-lock.json"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  // Off for now: sorting imports in src/ changes module evaluation order in the committed
  // browser bundle, which wants its own reviewed change rather than a CI-adoption PR.
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "off" } } }
}
